# =====================================================================
# MELLIS — zmienne środowiskowe
# Skopiuj ten plik do `.env.local` i uzupełnij wartościami.
# Na ten moment aplikacja działa BEZ żadnej z tych wartości (tryb demo).
# =====================================================================

# Publiczny adres sklepu (używany w linkach powrotu po płatności)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Płatności (Stripe) — do uzupełnienia w przyszłości ---
# Gdy te zmienne są ustawione, checkout przełączy się z trybu demo
# na prawdziwą sesję płatności Stripe (patrz lib/payments.ts).
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Alternatywnie: Przelewy24 ---
# P24_MERCHANT_ID=""
# P24_POS_ID=""
# P24_API_KEY=""
# P24_CRC=""
